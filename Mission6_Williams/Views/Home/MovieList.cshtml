@model List<Mission6_Williams.Models.Movie>

@{
    ViewData["Title"] = "Movie Collection";
}

<div class="container mt-5">
    <h2>Joel's Movie Collection</h2>

    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
        <tr>
            <th>Category</th>
            <th>Title</th>
            <th>Year</th>
            <th>Director</th>
            <th>Rating</th>
            <th>Edited</th>
            <th>Lent To</th>
            <th>Copied to Plex</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.Category?.CategoryName</td>
                <td>@x.Title</td>
                <td>@x.Year</td>
                <td>@x.Director</td>
                <td>@x.Rating</td>
                <td>@(x.Edited ? "Yes" : "No")</td>
                <td>@x.LentTo</td>
                <td>@(x.CopiedToPlex ? "Yes" : "No")</td>
                <td>
                    <a class="btn btn-warning btn-sm" asp-controller="Home" asp-action="Edit" asp-route-id="@x.MovieId">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-controller="Home" asp-action="Delete" asp-route-id="@x.MovieId">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>